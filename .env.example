# ==============================================================================
# Plantilla de Configuración de Entorno (LiveKit Teleoperación)
# Copia este archivo a .env y completa con tus credenciales reales:
#   cp .env.example .env
# ==============================================================================

# URL de WebSocket de LiveKit Cloud o servidor local
LIVEKIT_URL=wss://tu-proyecto.livekit.cloud

# Credenciales de API de LiveKit
LIVEKIT_API_KEY=tu_api_key_aqui
LIVEKIT_API_SECRET=tu_api_secret_aqui

# Nombre de la sala de teleoperación
LIVEKIT_ROOM=room-1

# Tópico de ROS 2 a transmitir (por defecto: /camera/color/image_raw)
L515_TOPIC=/camera/color/image_raw
